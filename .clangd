Diagnostics:
  UnusedIncludes: None
  Suppress: ["type_unsupported", "unknown_argument", "invalid_consteval_call"]
CompileFlags:
  Remove: [-freflection, -Wfatal-errors]
  Add: [-DCLANGD_PARSE=1, -DCPP26=1,-Dcpp26=1, -ferror-limit=0]
---
# Headers have no compile_commands.json entry, so clangd borrows a command from a
# "similar" .cpp, often a dependency's file without libassert's paths. Add them here.
If:
  PathMatch: 'include/.*\.hpp'
CompileFlags:
  Add:
    - -isystem/Users/llewie/code/proj/cpp26-refl/external/libassert/include
    - -isystem/Users/llewie/code/proj/cpp26-refl/build/dev/external/libassert/include
    - -isystem/Users/llewie/code/proj/cpp26-refl/external/cpptrace/include
    - -isystem/Users/llewie/code/proj/cpp26-refl/build/dev/_deps/cpptrace-build/include
    - -DLIBASSERT_STATIC_DEFINE
    - -DCPPTRACE_STATIC_DEFINE
