CompileFlags:
  Remove: [-freflection, -Wfatal-errors]
  Add: [-DCLANGD_PARSE=1]
---
# Disable all diagnostics in .refl.* files, but use the clang C++26 flags
If: 
  PathMatch: '.*\.refl\.(cpp|hpp)$'
CompileFlags:
  Add: [-std=c++2c, -ferror-limit=0]
Diagnostics:
  Suppress: "*"
Index:
  Background: Skip
